      "views": 181
    }
  ]
};
const articles = data.articles;
const categories = data.categories;

// ===== 辅助函数 =====
function json(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      'Content-Type': 'application/json; charset=utf-8',
      'Access-Control-Allow-Origin': '*',
    },
  });
}

// ===== 各路由处理 =====
async function handleApiCategories(env) {
  return json(categories);
}

async function handleApiArticles(env) {
  return json(articles);
}

async function handleApiArticleSlug(env, slug) {
  const article = articles.find((a) => a.slug === slug);
  if (!article) {
    return json({ error: 'not found' }, 404);
  }
  const key = `views:${slug}`;
  const current = await env.VIEWS.get(key, 'number');
  const views = (current ? parseInt(current, 10) : 0) + 1;
  await env.VIEWS.put(key, String(views), { expirationTtl: 365 * 24 * 3600 });
  return json({ ...article, views });
}

// 路由表：模式 -> 处理函数（按顺序匹配，支持 :param）
const routes = [
  { pattern: '/api/categories', handler: handleApiCategories },
  { pattern: '/api/articles', handler: handleApiArticles },
  { pattern: '/api/articles/:slug', handler: handleApiArticleSlug },
];

function matchRoute(url) {
  const path = url.pathname;
  for (const route of routes) {
    const parts = route.pattern.split('/');
    const segs = path.split('/');
    if (parts.length !== segs.length) continue;
    const params = {};
    let ok = true;
    for (let i = 0; i < parts.length; i++) {
      if (parts[i].startsWith(':')) {
        params[parts[i].slice(1)] = decodeURIComponent(segs[i]);
      } else if (parts[i] !== segs[i]) {
        ok = false;
        break;
      }
    }
    if (ok) return { handler: route.handler, params };
  }
  return null;
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    if (url.pathname.startsWith('/api/')) {
      const matched = matchRoute(url);
      if (matched) {
        return matched.handler(env, matched.params.slug);
      }
      return json({ error: 'not found' }, 404);
    }
    // 其余请求（静态文件 / 页面 / 404 回退）交给 ASSETS
    return env.ASSETS.fetch(request);
  },
};

