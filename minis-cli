#!/bin/sh
# minis-cli — Minis 统一命令行入口
# 用法: minis-cli <命令> <子命令> [参数...]
# 查看所有命令: minis-cli --help

BASE="/var/minis/shared"
VERSION="1.3.3"
JSON_MODE=0

# Global --json flag: parse ALL positional arguments for -j/--json
while [ $# -gt 0 ]; do
  case "$1" in
    --json|-j)
      JSON_MODE=1
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

# Set env var for subcommands that don't support --json flag directly
# Python scripts can check `os.environ.get("MINIS_JSON")` to adapt output format
export MINIS_JSON="$JSON_MODE"

usage() {
cat << 'HELP'
Minis CLI v1.0.0 — 统一命令行入口

用法: minis-cli <命令> [子命令] [参数...]

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
🔍 search       — 知识检索
   search         Obsidian 笔记搜索 (关键词/文件夹/分层)
   batch          批量搜索多个关键词

📚 knowledge    — 知识管理
   distill        知识卡片蒸馏 (创建/审核/批准/归档)
   graph          知识图谱构建 (解析 wiki-link)
   crossq         交叉验证 (发现矛盾/缺口)
   blindspot      认知盲区发现
   tag            标签提取与一致性检查
   analytics      搜索热度分析
   learn          学习轨迹记录
   sync           Obsidian 双向同步
   tiering        L0/L1/L2 分层内容处理
   error-learn    错误模式学习与修复
   ground         Grounded Claims (证据版本追踪/过期检测)
   okf            OKF v0.2 格式导出 (Google 标准知识格式)
   viz            知识图谱可视化器 (交互式节点图+Markdown阅读器)
   dreaming       记忆 Dreaming (离线固化/孤立检测/补链接)
   schema         Schema Learning (模式发现/字段校验/自动修复)

🧰 skill         — Skill 管理
   registry       Skill 注册表 (scan/list/show/validate)
   eval           Skill 评测门禁 (run/report/json)
   migrate        Skill 生产结构迁移
   lifecycle      Skill 生命周期管理
   duel         红蓝军自对弈
   route        Skill 组合路由（Decompose→Retrieve→Compose） (probe-banks/replay-history)

🧠 brain         — 第二大脑
   train          全量训练流水线 (11 步)
   pulse          轻量训练脉冲 (<3秒)
   scheduler      事件调度器 (定时任务/事件钩子/队列)
   dashboard      健康仪表盘 (健康分/图谱/雷达)
   feedback       反馈层 (PEV 传感器/根因分析)
   commit         Session 自动记忆提交
   auto-learn     自动学习管道 (manual/semi/auto)

📦 hub           — Skill 包管理器 (CLI-Anything CLI-Hub 借鉴)
   list           浏览 Skill-Hub 注册表
   search         搜索社区 Skill
   info           查看 Skill 详情
   install        安装 Skill
   update         更新 Skill
   uninstall      卸载 Skill
   status         查看 Hub 状态

