{
  "version": "1.1",
  "rules": {
    "era_words": {
      "name": "时代词汇（古风/玄幻禁用现代词）",
      "pattern_type": "any",
      "words": ["办公室","手机","电脑","公司","会议","经理","主任","老师","同学","班级","教室","医院","警察","汽车","飞机","电话","短信","微信","网络","打印","老板","项目","计划","方案","合同","工资","薪水","地铁","公交"],
      "severity": "error"
    },
    "realm_capability": {
      "name": "境界能力越界",
      "_fix_note": "FIX 2026-09-30：v1.0 境界名（炼气/筑基）保留以兼容旧数据；新增 mid_realm_v2（聚气/凝元/通玄）供 v2.0 苍玄界使用，旧键一律不删除。注意：gate-check.py 当前不加载本文件（孤儿配置），接入前需先打通加载路径。",
      "groups": {
        "low_realm": ["淬体一重","淬体二重","淬体三重","淬体四重","淬体五重","淬体六重","淬体七重","淬体八重","淬体九重"],
        "mid_realm": ["炼气初期","炼气中期","炼气后期","筑基初期","筑基中期","筑基后期"],
        "mid_realm_v2": ["聚气初期","聚气中期","聚气后期","凝元初期","凝元中期","凝元后期","通玄初期","通玄中期","通玄后期"]
      },
      "groups_low_forbidden": ["御剑飞行","神识","灵气外放","凌空","隔空","瞬移","飞行","神识扫描","灵觉"],
      "groups_high_forbidden": [],
      "severity": "error"
    },
    "divine_sense_boundary": {
      "name": "神器感应越界（只有主角能感知）",
      "trigger_words": ["天命剑","神器","神剑"],
      "sense_words": ["感应","察觉","听见","听到","看到","发现","感到","感受到","神色","脸色","心里发毛"],
      "severity": "error"
    },
    "time_contradiction": {
      "name": "时间线矛盾",
      "start_signals": ["开始集合","大比开始","钟声响起"],
      "pending_signals": ["即将开始","还没开始"],
      "window": 500,
      "severity": "warn"
    },
    "position_contradiction": {
      "name": "位置行为矛盾",
      "conflict_pairs": [
        ["最末尾","最早"],
        ["最后","第一个"],
        ["角落","最早"]
      ],
      "severity": "warn"
    },
    "modern_item_org_conflict": {
      "name": "门派/设定硬冲突",
      "mappings": {
        "天剑宗": ["阔刀","大刀","木棍","木棒","棍棒","棍","刀法","拳法","拳","掌法"]
      },
      "severity": "warn"
    },
    "causality": {
      "name": "因果链审查",
      "checks": [
        {
          "rule": "秘密泄露",
          "pattern": "([^你]?)天命剑([^你]?)[。！？]",
          "warn": "主角秘密可能被旁人感知",
          "severity": "error"
        },
        {
          "rule": "信息不对称",
          "pattern": "(王大|王执事)([^你]{0,10})(不知道|没看到|没听见)",
          "warn": "信息不对称需明确标注",
          "severity": "warn"
        }
      ]
    },
    "consistency": {
      "name": "章节连贯性",
      "checks": [
        {
          "rule": "兵器连贯",
          "field": "weapon",
          "check": "同一场景内武器不应变化",
          "severity": "warn"
        }
      ]
    }
  }
}